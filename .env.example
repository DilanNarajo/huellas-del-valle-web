# Copie este archivo a .env.local (local) o cree las variables en Vercel.
# Si faltan (o conservan el marcador PEGAR_AQUI_...), la app funciona en MODO DEMO.

# Webhook personalizado del Escenario 1 en Make (Agendar cita)
MAKE_WEBHOOK_URL=PEGAR_AQUI_URL_WEBHOOK_MAKE

# URL de la app web de Apps Script (termina en /exec)
APPS_SCRIPT_URL=PEGAR_AQUI_URL_APPS_SCRIPT_EXEC

# Token compartido: el mismo valor que la propiedad del script API_TOKEN
API_TOKEN=PEGAR_AQUI_TOKEN_LARGO_ALEATORIO
